# TRAINING + VISUALISASI BERSAMAAN
# ══════════════════════════════════════════════════════════════
def run_visual_training(brain=None, episodes=100):
    """Training sambil melihat visualisasi real-time."""
    viz = MaklukVisualizer()

    BATCH_SIZE          = 64
    GAMMA               = 0.99
    LR                  = 1e-3
    TARGET_UPDATE_STEPS = 500
    TRAIN_EVERY_N_STEPS = 4

    epsilon       = 1.0
    epsilon_min   = 0.05
    epsilon_decay = 0.995
    criterion     = nn.MSELoss()

    if brain is None:
        brain = AgentBrainManager(NUM_AGENTS, lr=LR)

    global_step = 0
    fps         = 10
    paused      = False

    print("=== VISUAL TRAINING DIMULAI ===")
    print("SPACE=pause  |  ←→=speed  |  R=reset ep  |  Q=quit\n")

    for episode in range(1, episodes + 1):
        env      = MaklukGabutEnv()
        total    = 0.0
        reset_ep = False

        for step in range(200):

            # ── Event handler ────────────────────────────────
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    viz.quit()
                    return brain
                if event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_q:
                        viz.quit()
                        return brain
                    if event.key == pygame.K_SPACE:
                        paused = not paused
                    if event.key == pygame.K_RIGHT:
                        fps = min(60, fps + 5)
                    if event.key == pygame.K_LEFT:
                        fps = max(1, fps - 5)
                    if event.key == pygame.K_r:
                        reset_ep = True

            if reset_ep:
                break

            if paused:
                viz.render(env, episode, step, total, epsilon, fps, paused=True)
                viz.clock.tick(15)
                continue

            # ── Step simulasi ─────────────────────────────────
            current_states = {
                i: get_agent_state(i, env)
                for i in range(NUM_AGENTS)
                if not env.agents[i].is_dead
            }
            if not current_states:
                break

            actions_dict   = {}
            action_indices = {}
            for i, state in current_states.items():
                if random.random() < epsilon:
                    idx = random.randrange(ACTION_SIZE)
                else:
                    with torch.no_grad():
                        idx = brain.policy_nets[i](
                            torch.FloatTensor(state).unsqueeze(0)
                        ).argmax().item()
                action_indices[i] = idx
                actions_dict[i]   = ACTION_MAP[idx]

            rewards_dict, _ = env.step(actions_dict)
            total      += sum(rewards_dict.values())
            global_step += 1

            game_done = all(a.is_dead for a in env.agents)

            for i in current_states:
                brain.memories[i].push(
                    current_states[i],
                    action_indices[i],
                    rewards_dict.get(i, -10.0),
                    get_agent_state(i, env),
                    game_done or env.agents[i].is_dead
                )

            # Training update
            if global_step % TRAIN_EVERY_N_STEPS == 0:
                for i in range(NUM_AGENTS):
                    if len(brain.memories[i]) < BATCH_SIZE:
                        continue
                    b_s, b_a, b_r, b_ns, b_d = brain.memories[i].sample(BATCH_SIZE)
                    b_s  = torch.FloatTensor(b_s)
                    b_a  = torch.LongTensor(b_a).unsqueeze(1)
                    b_r  = torch.FloatTensor(b_r).unsqueeze(1)
                    b_ns = torch.FloatTensor(b_ns)
                    b_d  = torch.BoolTensor(b_d).unsqueeze(1)
                    cur_q = brain.policy_nets[i](b_s).gather(1, b_a)
                    with torch.no_grad():
                        na      = brain.policy_nets[i](b_ns).argmax(1, keepdim=True)
                        nq      = brain.target_nets[i](b_ns).gather(1, na)
                        tgt_q   = b_r + GAMMA * nq * (~b_d)
                    loss = criterion(cur_q, tgt_q)
                    brain.optimizers[i].zero_grad()
                    loss.backward()
                    torch.nn.utils.clip_grad_norm_(brain.policy_nets[i].parameters(), 1.0)
                    brain.optimizers[i].step()

            if global_step % TARGET_UPDATE_STEPS == 0:
                brain.sync_all_targets()

            # Render
            viz.render(env, episode, step + 1, total, epsilon, fps)
            viz.clock.tick(fps)

            if game_done:
                break

        epsilon = max(epsilon_min, epsilon * epsilon_decay)
        alive   = sum(1 for a in env.agents if not a.is_dead)
        print(f"Ep {episode:>3} | Reward: {total:>8.1f} | ε: {epsilon:.3f} | Alive: {alive}/{NUM_AGENTS}")

    viz.quit()
    return brain


