if __name__ == "__main__":
    mode = sys.argv[1] if len(sys.argv) > 1 else "train_visual"

    if mode == "train_visual":
        # ── Training sambil lihat agen bergerak ─────────────
        trained = run_visual_training(brain=None, episodes=100)

    elif mode == "train_first":
        # ── Train cepat tanpa visual, baru demo ─────────────
        print("Training tanpa visual dulu (lebih cepat)...")
        trained = train_makluk_gabut()
        print("\nTraining selesai. Membuka demo visualisasi...\n")
        run_visual_demo(trained, episodes=20)

    elif mode == "demo":
        # ── Demo dengan brain kosong (belum dilatih) ─────────
        print("Demo dengan brain baru (belum dilatih)...")
        brain = AgentBrainManager(NUM_AGENTS)
        run_visual_demo(brain, episodes=20)

    else:
        print(f"Mode tidak dikenal: '{mode}'")
        print("Gunakan: train_visual | train_first | demo")
        
