# DEMO MURNI (TANPA TRAINING, EPSILON = 0)
# ══════════════════════════════════════════════════════════════
def run_visual_demo(brain, episodes=20):
    """
    Lihat brain yang sudah dilatih beraksi.
    Tidak ada exploration, murni eksploitasi.
    """
    viz = MaklukVisualizer()
    fps = 8

    print("=== DEMO MODE (ε=0) ===")
    print("←→=speed  |  Q=quit\n")

    for episode in range(1, episodes + 1):
        env   = MaklukGabutEnv()
        total = 0.0

        for step in range(200):
            for event in pygame.event.get():
                if event.type == pygame.QUIT:
                    viz.quit(); return
                if event.type == pygame.KEYDOWN:
                    if event.key == pygame.K_q:
                        viz.quit(); return
                    if event.key == pygame.K_RIGHT: fps = min(60, fps + 5)
                    if event.key == pygame.K_LEFT:  fps = max(1,  fps - 5)

            current_states = {
                i: get_agent_state(i, env)
                for i in range(NUM_AGENTS)
                if not env.agents[i].is_dead
            }
            if not current_states:
                break

            actions_dict = {}
            for i, state in current_states.items():
                with torch.no_grad():
                    idx = brain.policy_nets[i](
                        torch.FloatTensor(state).unsqueeze(0)
                    ).argmax().item()
                actions_dict[i] = ACTION_MAP[idx]

            rewards_dict, _ = env.step(actions_dict)
            total += sum(rewards_dict.values())

            viz.render(env, episode, step + 1, total, 0.0, fps)
            viz.clock.tick(fps)

            if all(a.is_dead for a in env.agents):
                break

        alive = sum(1 for a in env.agents if not a.is_dead)
        print(f"Ep {episode:>3} | Reward: {total:>8.1f} | Alive: {alive}/{NUM_AGENTS}")
        time.sleep(0.8)

    viz.quit()


