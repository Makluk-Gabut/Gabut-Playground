; --- Code Segment ---
F3 0F 10 05 30 00 00 00   ; MOVSS xmm0, [RIP+48] (Load input 32-bit float)
0F C6 C0 00               ; SHUFPS xmm0, xmm0, 0 (Broadcast input ke 4 slot xmm)
0F 10 0D 34 00 00 00      ; MOVUPS xmm1, [RIP+52] (Load 4 hidden weights)
0F 59 C1                  ; MULPS xmm0, xmm1      (Multiply: input * w1)
0F 58 05 39 00 00 00      ; ADDPS xmm0, [RIP+57] (Add: + b1)
0F 57 C9                  ; XORPS xmm1, xmm1      (Clear xmm1 untuk ReLU)
0F 5F C1                  ; MAXPS xmm0, xmm1      (ReLU: max(0, xmm0))
0F 10 15 3E 00 00 00      ; MOVUPS xmm2, [RIP+62] (Load 4 output weights)
66 0F 3A 40 C2 FF         ; DPPS xmm0, xmm2, 0xFF (Dot Product: sum(h * w2))
F3 0F 58 05 43 00 00 00   ; ADDSS xmm0, [RIP+67] (Add final bias: + b2)
F3 0F 11 05 48 00 00 00   ; MOVSS [RIP+72], xmm0  (Store final output)
B8 3C 00 00 00            ; MOV eax, 60           (Syscall exit)
48 31 FF                  ; XOR rdi, rdi          (Return 0)
0F 05                     ; SYSCALL               (Execute)

; --- Data Segment (IEEE-754 Floats) ---
; Input (1.5)             : 00 00 C0 3F
; W1 (0.5, 0.5, 0.5, 0.5) : 00 00 00 3F 00 00 00 3F 00 00 00 3F 00 00 00 3F
; B1 (0.1, 0.1, 0.1, 0.1) : CD CC CC 3D CD CC CC 3D CD CC CC 3D CD CC CC 3D
; W2 (0.2, 0.2, 0.2, 0.2) : CD CC 4C 3E CD CC 4C 3E CD CC 4C 3E CD CC 4C 3E
; B2 (0.05)               : CD CC 4C 3D

